{
  "manifest_version": 3,
  "name": "ADRIX",
  "version": "0.2.0",
  "description": "An EVM wallet extension: HD accounts, tokens, network management, and an EIP-1193 provider for dApps.",
  "action": {
    "default_popup": "index.html",
    "default_title": "ADRIX"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
